# Copia este archivo a mobile/.env y completa con TUS valores. Nunca subas mobile/.env.
# En desarrollo: la IP de tu PC en la red local. Con la API desplegada: la URL https pública (ver docs/deploy.md del backend).
EXPO_PUBLIC_API_URL=http://192.168.0.X:5258
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=<publishable-key>

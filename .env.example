# ==========================================
# COLOMBIA GO - EJEMPLO DE VARIABLES (.env.example)
# ==========================================

# Configuración Web (Vite)
VITE_APP_NAME="Colombia Go"
VITE_APP_ENV=development
VITE_API_BASE_URL=http://localhost:3000/api
VITE_GOOGLE_MAPS_API_KEY=tu_google_maps_api_key_aqui

# Configuración Móvil (Expo)
EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=tu_google_maps_api_key_movil

# Servidor / Backend (Opcional)
PORT=3000
DATABASE_URL=postgresql://usuario:password@localhost:5432/colombiago
JWT_SECRET=tu_clave_secreta_jwt
